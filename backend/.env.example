# Copia in .env. NON caricare mai .env su GitHub.
PORT=8080
# Chiave per cifrare le password delle caselle e firmare i login. Almeno 32 caratteri casuali.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INBOX_SECRET=
# Dove salva il database (default: ./data)
INBOX_DATA=

# --- OAuth (Gmail e Outlook/Hotmail). Vedi README, sezione OAuth.
# Indirizzo https con cui il TELEFONO raggiunge questo server (es. quello di "tailscale serve").
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
